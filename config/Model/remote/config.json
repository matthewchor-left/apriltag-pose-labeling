{
  "config_version": 1,
  "inputs": {
    "source": "../../../data/remote/calibration.mov",
    "intrinsics": "../../Camera/logi_hd_1080p/intrinsic.json"
  },
  "detector": {
    "dictionary": "36h11",
    "sensitivity": "relaxed"
